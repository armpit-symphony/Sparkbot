{
  "contract_version": "2026-08-02.3",
  "contract_name": "sparkbot-public-release-sync",
  "source_of_truth": {
    "repo": "source-of-truth-repo",
    "branch": "public-release-final-cleanup-assessment"
  },
  "public_repo": "https://github.com/sparkpit-labs/Sparkbot.git",
  "required_runtime_modules": {
    "public": [
      "backend/app/main.py",
      "backend/app/core/settings.py",
      "backend/app/api/health.py",
      "backend/app/api/capabilities.py",
      "backend/app/api/command_center.py",
      "backend/pyproject.toml",
      "frontend/package.json",
      "frontend/package-lock.json",
      "frontend/index.html",
      "frontend/src/main.tsx",
      "frontend/src/api.ts",
      "frontend/src/App.tsx"
    ],
    "source": [
      "backend/app/main.py",
      "backend/app/core/config.py",
      "backend/app/api/main.py",
      "backend/app/api/deps.py",
      "backend/app/core/security.py",
      "backend/pyproject.toml",
      "package-lock.json",
      "frontend/package.json",
      "frontend/index.html",
      "frontend/src/main.tsx"
    ]
  },
  "feature_matrix": {
    "backend-health": "available",
    "frontend-shell": "available",
    "workstation": "preview",
    "chat": "preview",
    "work-page": "preview",
    "round-table": "preview",
    "provider-setup": "preview",
    "local-ai-settings": "preview",
    "guardian-controls": "preview",
    "desktop-packaging": "planned",
    "connectors": "guarded-future",
    "model-calls": "guarded-future",
    "credential-storage": "guarded-future",
    "tool-execution": "guarded-future",
    "command-center": "disabled-by-default"
  },
  "routing_guarantees": [
    "GET /health is read-only and always returns service mode",
    "GET /capabilities is the authoritative contract surface for feature status",
    "Protected command-center actions flow through policy engine checks before execution",
    "State and audit endpoints are deterministic read-only views"
  ],
  "safety_gates": {
    "require_confirmation_for": [
      "chat_execution",
      "connectors",
      "terminal",
      "web",
      "model-calls",
      "tool-execution"
    ],
    "break_glass": {
      "enabled_by_default": false,
      "requires_policy_token": true,
      "audit_mandatory": true
    },
    "global_kill_switch": true,
    "rollback_mode": true,
    "per_feature_flags": [
      "chat_execution",
      "connectors",
      "terminal",
      "web",
      "model-calls",
      "tool-execution"
    ],
    "rate_limits": {
      "tenant_rate_limit_per_minute": 60,
      "tenant_anomaly_cap_per_minute": 18,
      "queue_backlog_limit": 32
    },
    "connector_registry": {
      "allow_by_default": [
        "slack",
        "github",
        "discord"
      ],
      "deny_when_listed": true
    },
    "audit": {
      "immutable": true,
      "hash_chain": true,
      "retention": 500,
      "redaction_required": true
    }
  },
  "approved_removed_artifacts": [
